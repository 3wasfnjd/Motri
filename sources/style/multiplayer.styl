.multiplayer-hud
    position absolute
    top calc(10px + env(safe-area-inset-top))
    right calc(10px + env(safe-area-inset-right))
    z-index 16
    min-width 94px
    padding 7px 10px
    border 1px solid rgba(255, 255, 255, .16)
    border-radius 10px
    background rgba(20, 20, 22, .72)
    color rgba(255, 255, 255, .72)
    font-family Arial, sans-serif
    font-size 11px
    line-height 1.25
    text-align right
    direction rtl
    pointer-events none
    backdrop-filter blur(6px)

    &.is-connected
        color #fff

    .multiplayer-hud-status
        font-weight 700
        white-space nowrap

    .multiplayer-hud-room
        margin-top 2px
        opacity .62
        font-size 9px

.multiplayer-name-tag
    position absolute
    top 0
    left 0
    z-index 15
    padding 4px 7px
    border 1px solid rgba(255, 255, 255, .18)
    border-radius 7px
    background rgba(18, 18, 20, .76)
    color #fff
    font-family Arial, sans-serif
    font-size 10px
    font-weight 700
    line-height 1
    white-space nowrap
    pointer-events none
    user-select none
    unicode-bidi plaintext
    will-change transform

@media (max-width: 600px)
    .multiplayer-hud
        top calc(8px + env(safe-area-inset-top))
        right calc(8px + env(safe-area-inset-right))
        padding 6px 8px
        font-size 10px

    .multiplayer-name-tag
        font-size 9px
        padding 3px 6px
