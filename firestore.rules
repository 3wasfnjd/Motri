rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /whispers/{userId} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'message',
          'countryCode',
          'x',
          'y',
          'z',
          'createdAt'
        ])
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 30
        && request.resource.data.countryCode is string
        && request.resource.data.countryCode.size() <= 2
        && request.resource.data.x is number
        && request.resource.data.y is number
        && request.resource.data.z is number
        && request.resource.data.x >= -2000
        && request.resource.data.x <= 2000
        && request.resource.data.y >= -200
        && request.resource.data.y <= 1000
        && request.resource.data.z >= -2000
        && request.resource.data.z <= 2000
        && request.resource.data.createdAt == request.time;

      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }
    match /circuitLeaderboard/{dayKey}/scores/{userId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['tag', 'countryCode', 'duration', 'createdAt'])
        && request.resource.data.tag is string
        && request.resource.data.tag.matches('^[A-Z]{3}$')
        && request.resource.data.countryCode is string
        && request.resource.data.countryCode.size() <= 2
        && request.resource.data.duration is number
        && request.resource.data.duration >= 5000
        && request.resource.data.duration <= 600000
        && request.resource.data.createdAt == request.time;

      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['tag', 'countryCode', 'duration', 'createdAt'])
        && request.resource.data.tag is string
        && request.resource.data.tag.matches('^[A-Z]{3}$')
        && request.resource.data.countryCode is string
        && request.resource.data.countryCode.size() <= 2
        && request.resource.data.duration is number
        && request.resource.data.duration >= 5000
        && request.resource.data.duration <= resource.data.duration
        && request.resource.data.createdAt == request.time;

      allow delete: if false;
    }

  }
}
